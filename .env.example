# Banco (Docker local: postgresql://postgres:postgres@localhost:5433/showing)
DATABASE_URL=

# Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET=

# IA (OpenRouter: openrouter.ai). AI_MODEL é o id do modelo, como em openrouter.ai/models.
# Sem estas duas variáveis a bolha de chat usa o atendente simulado.
AI_API_KEY=
AI_MODEL=
# Opcional: outro endpoint compatível com a API da OpenAI (padrão: OpenRouter)
AI_BASE_URL=

# Appwrite Storage (só servidor)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# E-mail (Gmail com senha de app: Conta Google → Segurança → Verificação em duas etapas → Senhas de app; nunca a senha normal)
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Showing

# URL pública do site
NEXT_PUBLIC_SITE_URL=

# Só desenvolvimento: 1 = painel sem login, dados em memória e fotos em public/mock-uploads
USAR_MOCKS=

# Contato para pedidos de privacidade (aparece em /privacidade). Se vazio, a página manda falar com o corretor.
NEXT_PUBLIC_EMAIL_PRIVACIDADE=

# Opcional: e-mail do corretor criado pelo seed (só e-mail cadastrado entra no painel)
SEED_CORRETOR_EMAIL=

# Prazo de guarda: dias sem atividade até a conversa ser anonimizada (padrão 180). A /privacidade mostra este valor.
RETENCAO_DIAS=
# Segredo da rotina diária POST /api/cron/retencao (Authorization: Bearer ...). Gere com: openssl rand -base64 32
CRON_SECRET=

# Custo do modelo (BK-09): mensagens do atendente por dia antes de cair no atendente simulado (padrão 300)
AI_LIMITE_DIARIO=
# Preço do modelo em US$ por 1 milhão de tokens (openrouter.ai/models), para `pnpm custo` estimar o gasto
AI_PRECO_ENTRADA=
AI_PRECO_SAIDA=

# Só o corretor no seed, sem o imóvel de exemplo publicado (use em homologação e produção)
SEED_SO_CORRETOR=
# Deixe vazio em testes/homologação: o site pede para não ser indexado. Use 1 só no site de verdade (variável de BUILD).
NEXT_PUBLIC_PERMITIR_INDEXACAO=
