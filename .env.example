# Banco (Docker local: postgresql://postgres:postgres@localhost:5433/showing)
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# IA (OpenRouter: openrouter.ai). AI_MODEL é o id do modelo, como em openrouter.ai/models.
# Sem estas duas variáveis a bolha de chat usa o atendente simulado.
AI_API_KEY=
AI_MODEL=
# Opcional: outro endpoint compatível com a API da OpenAI (padrão: OpenRouter)
AI_BASE_URL=

# Appwrite Storage (só servidor)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# URL pública do site
NEXT_PUBLIC_SITE_URL=

# Só desenvolvimento: 1 = painel sem login, dados em memória e fotos em public/mock-uploads
USAR_MOCKS=
